# SYNALUM AI Mentor — contoh environment.
# Salin ke .env (JANGAN commit .env):  cp .env.example .env
# Tanpa GEMINI_API_KEY, server jalan MODE DEMO (balasan contoh, demo:true).

# WAJIB untuk mode live — API key Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Opsional
PORT=3000
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.8
# Paksa mode demo meski key terisi (untuk tes): 1
# SYNALUM_MOCK=1
# Batas rate limit /api/chat: 30 permintaan per IP per 60 detik
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
# Origin CORS yang diizinkan (* = semua; isi domain untuk produksi)
CORS_ORIGIN=*
